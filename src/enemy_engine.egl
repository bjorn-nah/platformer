func Enemy_Init:uint16 n
{
	MODE16
	
	idy = n;
	idx = 0;
	do
	{	
		acc = 0x00
		
		[ENEMY.x,idx] = acc;
		[ENEMY.y,idx] = acc;
		[ENEMY.vx,idx] = acc;
		[ENEMY.vy,idx] = acc;
		[ENEMY.type,idx] = acc;
		[ENEMY.status,idx] = acc;
		[ENEMY.visible,idx] = acc;
		[ENEMY.dummy02,idx] = acc;
		[ENEMY.dummy03,idx] = acc;
		[ENEMY.dummy04,idx] = acc;
		
		idx += 0x10
	}
	loop idy == 0

	
	MODE8
}

